# ---- Required for "Chat with May" ----
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (default claude-sonnet-5-5; claude-haiku-5-5 is cheaper)
CHAT_MODEL=claude-sonnet-5-5

# ---- Lead notifications (optional but recommended) ----
# Create a free account at https://resend.com, verify a sender domain, then:
RESEND_API_KEY=re_...
FROM_EMAIL="May <hello@your-domain.com>"
NOTIFY_EMAIL=may@example.com

# ---- Database (leads, assistant notes & documents, guides, diary) ----
# Leave empty to use JSON files in ./data (fine for local dev or a single server).
# On Vercel this is REQUIRED (the filesystem is read-only): add a Postgres database (Neon)
# and paste its connection string here. Tables are created and the original guides/diary
# are copied in automatically on first use.
DATABASE_URL=

# ---- Admin area: /admin (login) ----
ADMIN_USERNAME=may
# A long password only May knows. Changing it signs out every device.
ADMIN_PASSWORD=change-me
# Optional: separate key for signing the login cookie (long random string).
# If empty, one is derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# ---- Public URL (no trailing slash) ----
NEXT_PUBLIC_SITE_URL=https://www.may-advisor.com
