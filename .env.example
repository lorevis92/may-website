# ---- Required for "Chat with May" ----
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (default claude-sonnet-5-5; claude-haiku-5-5 is cheaper)
CHAT_MODEL=claude-sonnet-5-5

# ---- Lead notifications (optional but recommended) ----
# Create a free account at https://resend.com, verify a sender domain, then:
RESEND_API_KEY=re_...
FROM_EMAIL="May <hello@your-domain.com>"
NOTIFY_EMAIL=may@example.com

# ---- Lead storage ----
# Leave empty to store leads in ./data/leads.jsonl (fine for a single server).
# On Vercel, add a Postgres database (Neon) and paste its connection string here.
DATABASE_URL=

# ---- Private leads page: /admin/leads?token=...  (use a long random string) ----
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- Public URL (no trailing slash) ----
NEXT_PUBLIC_SITE_URL=https://www.may-advisor.com
